<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="GRETL Datenportal Jobs">
        <f:entry title="Anzeigename" field="displayName">
            <f:textbox />
        </f:entry>
        <f:entry title="URL Name" field="urlName">
            <f:textbox />
        </f:entry>
        <f:entry title="Themen-Repo URL" field="topicRepositoryUrl">
            <f:textbox />
        </f:entry>
        <f:entry title="Themen-Repo Modus" field="topicRepositoryMode">
            <f:textbox />
        </f:entry>
        <f:entry title="Themen-Repo Branch" field="topicRepositoryBranch">
            <f:textbox />
        </f:entry>
        <f:entry title="Themen-Repo Pfad" field="topicRepositoryPath">
            <f:textbox />
        </f:entry>
        <f:entry title="Git HTTPS Credential ID" field="topicRepositoryCredentialsId"><f:textbox /></f:entry>
        <f:entry title="Git-Rückschreiben aktivieren" field="topicRepositoryWriteBackEnabled"><f:checkbox /></f:entry>
        <f:entry title="Git Committer Name" field="topicRepositoryCommitterName"><f:textbox /></f:entry>
        <f:entry title="Git Committer E-Mail" field="topicRepositoryCommitterEmail"><f:textbox /></f:entry>
        <f:entry title="Seed-Job automatisch erstellen" field="seedJobAutoCreate">
            <f:checkbox />
        </f:entry>
        <f:entry title="Seed-Job Cron" field="seedJobCron">
            <f:textbox />
        </f:entry>
        <f:entry title="Seed-Job Builds behalten" field="seedJobBuildsToKeep">
            <f:number />
        </f:entry>
        <f:entry title="Seed-Job Operators Team" field="seedJobOperatorsTeam">
            <f:textbox />
        </f:entry>
    </f:section>
</j:jelly>
